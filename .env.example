# ----------------------------------------------------------------------------
# Beispiel-Umgebungsvariablen. Datei nach ".env" kopieren und Werte eintragen.
# (docker-compose liest .env automatisch.)
# ----------------------------------------------------------------------------

# Google OAuth-Client (Web-Anwendung) aus der Google Cloud Console
GOOGLE_CLIENT_ID=dein-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dein-client-secret

# Muss EXAKT als autorisierte Redirect-URI im OAuth-Client hinterlegt sein.
# Lokal: http://localhost:8000/api/oauth/callback
# Prod:  https://deine-domain.tld/api/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/callback

# Auszuwertender Kalender (primary = Hauptkalender)
CALENDAR_ID=primary

# Token, mit dem das Apps-Script-Add-on GET /api/projects abruft.
# Identischer Wert muss im Add-on (ADDON_API_TOKEN) gesetzt sein.
ADDON_API_TOKEN=ein-langes-zufaelliges-token

# Passwort für den Login der Webapp-UI (Single-User).
APP_PASSWORD=bitte-aendern

# Optional: Secret zum Signieren der Session-Cookies. Leer = aus APP_PASSWORD abgeleitet.
SESSION_SECRET=
